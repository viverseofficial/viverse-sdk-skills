{
  "name": "@viverseofficial/viverse-playcanvas-toolkit",
  "version": "0.1.12",
  "packageManager": "pnpm@10.22.0",
  "private": true,
  "type": "module",
  "files": [],
  "engines": {
    "node": ">= 24.11.0",
    "pnpm": ">= 10.22.0"
  },
  "scripts": {
    "dev": "pnpm dev:preview",
    "dev:preview": "cd apps/preview && pnpm dev",
    "dev:cdn": "cd mock/cdn-server && pnpm dev",
    "create:engine-only-world": "node scripts/create-engine-only-world.mjs",
    "create:leaderboard-runtime-boundary": "node scripts/create-leaderboard-runtime-boundary.mjs",
    "curate:toolkit-api-index": "node scripts/curate-toolkit-api-index.mjs",
    "discover:toolkit-api-candidates": "node scripts/discover-toolkit-api-candidates.mjs",
    "publish:viverse": "node scripts/publish-build-output-to-viverse.mjs",
    "refresh:toolkit-api-knowledge": "node scripts/refresh-toolkit-api-knowledge.mjs",
    "refresh:toolkit-source-lock": "node scripts/refresh-toolkit-source-lock.mjs",
    "review:nontechnical-ux": "node scripts/check-nontechnical-user-ux.mjs",
    "smoke:engine-only-world": "node scripts/run-engine-only-world-smoke.mjs",
    "setup:playcanvas-sync": "node scripts/setup-playcanvas-sync.mjs",
    "validate:default-room-multiplayer": "node scripts/validate-default-room-multiplayer.mjs",
    "validate:engine-only-world": "node scripts/validate-engine-only-world.mjs",
    "validate:toolkit-api-fixtures": "node scripts/validate-toolkit-api-fixtures.mjs",
    "validate:toolkit-api-regressions": "node scripts/validate-toolkit-api-regressions.mjs",
    "validate:leaderboard-integration": "node scripts/validate-leaderboard-integration.mjs",
    "clean": "turbo run clean",
    "clean:all": "pnpm clean && rm -rf .turbo && rm -rf node_modules/.cache",
    "build": "pnpm build:extension",
    "build:packages": "turbo run build --filter=\"!@viverse/editor-extension\"",
    "build:extension": "MINIFY=true turbo run build:extension && cd apps/editor-extension && pnpm build",
    "gen-docs": "turbo run build:docs && typedoc",
    "type-check": "turbo run type-check",
    "lint": "eslint .",
    "prettier": "prettier --write \"**/*.{ts,js,tsx,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.34.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fs-extra": "^11.3.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.6",
    "typedoc": "^0.28.12",
    "typedoc-github-theme": "^0.3.1",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.42.0",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-plugin-svgr": "^4.5.0"
  },
  "dependencies": {
    "@viverse/cli": "0.9.6-alpha.4",
    "playcanvas": "catalog:"
  }
}
