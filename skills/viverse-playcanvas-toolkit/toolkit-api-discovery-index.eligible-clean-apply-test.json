{
  "version": 1,
  "purpose": "API-level discovery cues for agents that need to map user intent to concrete Toolkit APIs before inventing bespoke logic.",
  "usageRule": [
    "Use this index after behavior decomposition and before writing custom scene logic.",
    "Prefer APIs with matching intent cues before falling back to manual polling, ad hoc state flags, or custom DOM glue.",
    "Treat this as the API-level companion to toolkit-capability-catalog.json."
  ],
  "packages": [
    {
      "packageName": "@viverse/local-player",
      "apis": [
        {
          "name": "LocalPlayerSystem",
          "kind": "system",
          "intentCues": [
            "player controller",
            "character movement",
            "camera follow",
            "avatar locomotion",
            "xr player"
          ],
          "useWhen": [
            "the world needs a controllable local avatar",
            "camera and locomotion should come from Toolkit instead of custom controller glue"
          ],
          "sourceEvidence": [
            "scripts/templates/engine-only-world/main.toolkit-player.js.template",
            "scripts/templates/engine-only-world/main.toolkit-quest-ui.js.template",
            "packages/local-player/guide.md"
          ]
        }
      ]
    },
    {
      "packageName": "@viverse/quest",
      "apis": [
        {
          "name": "QuestSystem",
          "kind": "system",
          "intentCues": [
            "quest tracking",
            "objective progress",
            "task completion",
            "mission flow"
          ],
          "useWhen": [
            "the request needs event-driven quest state or objective tracking",
            "task progress should be managed by Toolkit instead of ad hoc flags"
          ],
          "sourceEvidence": [
            "scripts/templates/engine-only-world/main.toolkit-quest-ui.js.template",
            "packages/quest/guide.md"
          ]
        }
