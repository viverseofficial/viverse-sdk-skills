{
  "version": 1,
  "purpose": "API-level discovery cues for agents that need to map user intent to concrete Toolkit APIs before inventing bespoke logic.",
  "usageRule": [
    "Use this index after behavior decomposition and before writing custom scene logic.",
    "Prefer APIs with matching intent cues before falling back to manual polling, ad hoc state flags, or custom DOM glue.",
    "Treat this as the API-level companion to toolkit-capability-catalog.json."
  ],
  "hintGuide": {
    "configFields": {
      "useFor": [
        "real config object fields that materially change how a trigger, action, or similar API should be wired"
      ],
      "avoidWhen": [
        "the detail is only a low-value parameter or a private implementation member",
        "the main risk is not field naming but attaching the API to the wrong source object"
      ],
      "examples": [
        "EntityTriggerEnterTrigger.filterByPlayer",
        "EntityTriggerEnterTrigger.tagsFilter",
        "EntitySelectedTrigger.selectionExcludeTags",
        "QuestAction.type"
      ]
    },
    "constructionHints": {
      "useFor": [
        "APIs that are usually created from an existing Toolkit or PlayCanvas object rather than selected by one config field"
      ],
      "avoidWhen": [
        "the API is already well described by configFields alone",
        "the hint would duplicate obvious constructor arguments without changing routing"
      ],
      "examples": [
        "VideoTextureControls.videoTexture",
        "SoundControls.soundComponent",
        "SoundControls.slotName"
      ]
    },
    "capabilityHints": {
      "useFor": [
        "important built-in behavior that should stop the agent from rebuilding the same control surface or helper flow from scratch"
      ],
      "avoidWhen": [
        "the hint only restates the API name",
        "the behavior is too generic to change implementation choice"
      ],
      "examples": [
        "VideoTextureControls.playback controls",
        "VideoTextureControls.seek controls",
        "SoundControls.volume controls"
      ]
    }
  },
